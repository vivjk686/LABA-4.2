#include <iostream>
#include <iomanip>
#include <cmath>

using namespace std;

int main()
{
	double x, xp, xk, dx, A, B, y;

	cout << "xp = "; cin >> xp;
	cout << "xk = "; cin >> xk;
	cout << "dx = "; cin >> dx;

	cout << fixed;
	cout << "-------------------------" << endl;
	cout << "|" << setw(5) << "x" << "    |"
		<< setw(7) << "y" << "      |" << endl;
	cout << "-------------------------" << endl;

	x = xp;
	while (x <= xk)
	{
		A = 1 / pow(x, 3) + 1;

		if (x < 1)
			B = 0.3 * x + 7;
		else
			if (x <= 5.5)
				B = atan((x + 2) / 8.1) + exp(x);
			else
				B = sqrt(1 + sqrt(1 + sqrt(x)));

		y = A - B;

		cout << "|" << setw(8) << setprecision(2) << x
			<< " |" << setw(12) << setprecision(3) << y
			<< " |" << endl;

		x += dx;
	}
	cout << "-------------------------" << endl;

	return 0;
}
